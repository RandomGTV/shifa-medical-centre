# Admin content manager — required for /admin to work.
# Copy this file to .env.local and fill both in. Never commit .env.local.

# The password staff type at /admin/login. Choose a long one.
ADMIN_PASSWORD=

# Signs the admin session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Where saved edits are stored.
# Leave both blank and edits go to .content/site.json — fine locally and on a VPS,
# but they will NOT survive on a serverless host such as Vercel.
# Create a free Upstash Redis database and paste its REST credentials here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
